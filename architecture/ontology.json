{
  "architecture_id": "SMG-HPC-10X-ARCH",
  "version": "1.1.0",
  "status": "accepted_for_R2_mechanism_decomposition",
  "principles": [
    "The eight core families are candidate anchors, not a linear funnel.",
    "Hierarchy is for retrieval and composition; causality and influence live in the graph.",
    "Scientific evidence, runtime coefficients, and measurements are separate object classes.",
    "Every material inference must be traceable to atomic claims and context.",
    "Uncertainty is multidimensional and must not be collapsed into a fake probability."
  ],
  "layers": [
    {
      "level": "L0",
      "kind": "core",
      "purpose": "Broad psychological functional family; stable top-level anchor."
    },
    {
      "level": "L1",
      "kind": "module",
      "purpose": "Mechanism cluster that groups related neurons for explanation, retrieval, and verification."
    },
    {
      "level": "L2",
      "kind": "neuron",
      "purpose": "Smallest normally reusable psychological construct/mechanism that can own evidence, edges, and measurement mappings."
    },
    {
      "level": "L3",
      "kind": "micro_neuron",
      "purpose": "Optional decomposition used only when an L2 neuron still bundles empirically separable mechanisms or measurements."
    }
  ],
  "core_anchors": [
    "attention",
    "curiosity",
    "valuation_emotion",
    "identity",
    "trust",
    "connection",
    "social_transmission",
    "reinforcement_habit"
  ],
  "module_role_vocabulary": [
    "detection_representation",
    "appraisal_valuation",
    "motivation_drive",
